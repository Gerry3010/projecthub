#!/usr/bin/env bash
# ProjectHub desktop launcher — starts the PACKAGED app, not the repo checkout.
#
# Generated by `make install` from packaging/linux/projecthub.in. Do not edit the
# installed copy; edit the template and reinstall.
#
# The bundle lives outside the repo on purpose: rebuilding, rebasing or a dirty
# working tree must never take the installed app down with it. The AppImage
# carries its own Electron, the phd sidecar and web/*, so nothing here depends on
# node_modules or a build step being present.
#
# To update after code changes:  cd @REPO@ && make install
# To run the repo checkout instead (live dev build):  projecthub --dev
set -euo pipefail

APPIMAGE="@APPIMAGE@"
REPO_APP="@REPO@/app"

if [[ "${1:-}" == "--dev" ]]; then
  shift
  ELECTRON="$REPO_APP/node_modules/.bin/electron"
  if [[ ! -x "$ELECTRON" ]]; then
    echo "projecthub: electron not found at $ELECTRON — run 'npm install' in $REPO_APP" >&2
    exit 1
  fi
  cd "$REPO_APP"
  exec "$ELECTRON" . "$@"
fi

if [[ ! -x "$APPIMAGE" ]]; then
  echo "projecthub: bundle missing at $APPIMAGE — run 'make install' in @REPO@," >&2
  echo "            or start the dev build with: projecthub --dev" >&2
  exit 1
fi

exec "$APPIMAGE" "$@"
