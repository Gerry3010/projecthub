{
  "name": "projecthub-desktop",
  "version": "0.1.0",
  "description": "ProjectHub desktop shell (Electron) — hosts the go-app WASM UI and supervises the Go sidecar.",
  "license": "AGPL-3.0-or-later",
  "author": "Gerald Hofbauer <info@geraldhofbauer.net>",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:shell": "esbuild renderer/shell/index.ts --bundle --minify --format=iife --outfile=../web/shell.js",
    "build:all": "npm run build && npm run build:shell",
    "dev": "npm run build:all && electron .",
    "start": "electron .",
    "e2e": "node scripts/drive.mjs",
    "e2e:remember": "node scripts/remember.mjs",
    "e2e:server": "node scripts/server.mjs"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.2.0",
    "markdown-it": "^14.1.0",
    "thememirror": "^2.0.1"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.0",
    "electron": "^33.2.0",
    "esbuild": "^0.24.0",
    "playwright": "^1.49.0",
    "typescript": "^5.7.0"
  }
}
