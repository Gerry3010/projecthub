{
  "name": "projecthub-desktop",
  "version": "0.1.0",
  "description": "ProjectHub desktop shell (Electron) — hosts the go-app WASM UI and supervises the Go sidecar.",
  "license": "AGPL-3.0-or-later",
  "author": "Gerald Hofbauer <info@geraldhofbauer.net>",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:shell": "esbuild renderer/shell/index.ts --bundle --minify --format=iife --outfile=../web/shell.js",
    "build:all": "npm run build && npm run build:shell",
    "dev": "npm run build:all && electron .",
    "start": "electron .",
    "e2e": "node scripts/drive.mjs",
    "e2e:remember": "node scripts/remember.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "dompurify": "^3.2.0",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.0",
    "electron": "^33.2.0",
    "esbuild": "^0.24.0",
    "playwright": "^1.49.0",
    "typescript": "^5.7.0"
  }
}
