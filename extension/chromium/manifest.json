{
  "manifest_version": 3,
  "name": "ProjectHub Live Tabs",
  "version": "0.1.0",
  "description": "Meldet die aktuell offenen Tabs live an die ProjectHub-Desktop-App.",
  "key": "",
  "permissions": ["tabs", "tabGroups", "nativeMessaging", "alarms", "storage"],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "action": { "default_title": "ProjectHub Live Tabs", "default_popup": "popup.html" },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
